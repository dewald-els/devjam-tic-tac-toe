# Used only by `bun run build:itch`. Not secrets: these end up in the public bundle.
VITE_SOCKET_URL=wss://portfolio-devjam-tictactoe.azurewebsites.net
# Invite links point at the live site, so friends can join from any browser.
VITE_INVITE_BASE=https://portfolio-devjam-tictactoe.azurewebsites.net
# itch.io has no server-side route fallback, so use #/ routes.
VITE_ROUTER_HASH=1
