{
  "name": "v-tic-tac-toe",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:itch": "vue-tsc --noEmit && vite build --mode itch && bun scripts/zip-itch.ts",
    "test": "bun test",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.17.2",
    "socket.io": "^4.4.1",
    "vue": "^3.2.25",
    "vue-router": "^4.0.12",
    "socket.io-client": "^4.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@vitejs/plugin-vue": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "fflate": "^0.8.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^4.4.4",
    "vite": "^2.7.2",
    "vue-tsc": "^0.29.8"
  }
}
